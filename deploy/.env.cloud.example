# 华为云部署环境变量模板 —— 复制为 deploy/.env.cloud 后填写，不要提交到仓库
# 注意：.env.cloud 已被 .gitignore 覆盖；若没有，请手动确认不要 push

# --- RDS for PostgreSQL（私网地址，如 192.168.x.x）---
PG_DSN=host=<RDS私网IP> port=5432 dbname=strokeqc user=stroke password=<改我>

# --- DCS for Redis ---
REDIS_HOST=<DCS私网IP>
REDIS_PORT=6379
REDIS_PASSWORD=<改我>

# --- 会话签名密钥：必须换成随机值，否则会话可伪造 ---
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=<改我-48位随机串>
