# 本地 / 演示环境
APP_HOST=127.0.0.1
APP_PORT=8080

# 数据库（与 docker-compose.dev.yml 对应）
PG_DSN=host=127.0.0.1 port=5432 dbname=strokeqc user=stroke password=stroke_local_pwd
PG_PASSWORD=stroke_local_pwd

# 缓存
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redis_local_pwd

# 会话签名密钥：不设会用内置演示密钥，公网部署必须改
SESSION_SECRET=change-me-in-production

# 仿真
SEED=42
TODAY=2026-10-31
CURRENT_PERIOD=2026-10
